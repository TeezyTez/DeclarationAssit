# MPCI Q&A System - Configuration
# Copy this to .env and fill in your values

# LLM Backend: "auto", "openai" (for DeepSeek/OpenAI), "claude", or "template"
MPCI_LLM_TYPE=auto

# For DeepSeek (set base URL to DeepSeek's endpoint)
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# For OpenAI (uncomment to use OpenAI directly)
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# For Claude (uncomment to use Claude)
# MPCI_LLM_TYPE=claude
# ANTHROPIC_API_KEY=your-claude-key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Server settings
MPCI_HOST=0.0.0.0
MPCI_PORT=8000
MPCI_WORKERS=4
